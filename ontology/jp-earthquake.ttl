@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix jpe: <https://seismic.balog.jp/ontology/jp-earthquake.ttl#> .

<https://seismic.balog.jp/ontology/jp-earthquake.ttl#>
    a owl:Ontology ;
    rdfs:label "地震オントロジー"@ja , "Earthquake Ontology for Seismic Datasets"@en ;
    dcterms:creator [ foaf:homepage <https://seismic.balog.jp/> ; foaf:name "hiroki_u" ] ;
    dcterms:issued "2022-10-16"^^xsd:date ;
    dcterms:modified "2026-08-19"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "2026-08-19" .

# Classes
jpe:earthquake a owl:Class ;
    rdfs:label "地震現象"@ja , "earthquake"@en ;
    rdfs:subClassOf schema:Event , sosa:FeatureOfInterest .

jpe:hypocenter a owl:Class ;
    rdfs:label "震源"@ja , "hypocenter"@en ;
    rdfs:subClassOf schema:Place , sosa:FeatureOfInterest .

jpe:epicenter a owl:Class ;
    rdfs:label "震央"@ja , "epicenter"@en ;
    rdfs:subClassOf schema:Place , sosa:FeatureOfInterest .

jpe:observer a owl:Class ;
    rdfs:label "観測点"@ja , "observation station"@en ;
    rdfs:comment "住所が提供される場合はschema:addressとIMI共通語彙基盤（ic:住所、ic:都道府県、ic:都道府県コード、ic:市区町村、ic:市区町村コード）を併用する。"@ja ;
    skos:prefLabel "観測点"@ja , "observation station"@en ;
    rdfs:subClassOf sosa:Sensor .

jpe:seismicMotion a owl:Class ;
    rdfs:label "地震動"@ja , "seismic motion"@en ;
    rdfs:subClassOf sosa:Observation .

jpe:observedWave a owl:Class ;
    rdfs:label "観測波形"@ja , "observed wave"@en ;
    rdfs:subClassOf sosa:Observation .

jpe:DatasetSnapshot a owl:Class ;
    rdfs:label "データセット・スナップショット"@ja , "dataset snapshot"@en ;
    rdfs:comment "外部機関のデータセットを特定の取得時点でRDFへ変換した、不変の版。各版は独立した名前付きグラフとして管理する。"@ja ,
        "An immutable RDF rendition of an external dataset as retrieved at a specific time. Each rendition is managed as a separate named graph."@en ;
    rdfs:subClassOf dcat:Dataset , prov:Entity .

jpe:StrongMotionRecord a owl:Class ;
    rdfs:label "強震記録"@ja , "strong-motion record"@en ;
    rdfs:comment "観測点で得られた強震波形またはそこから算出した主要指標を表す。"@ja ;
    rdfs:subClassOf sosa:Observation .

# Datatype properties used by the published JMA and FDSN datasets
jpe:originTime a owl:DatatypeProperty ;
    rdfs:label "オリジンタイム"@ja , "origin time"@en ;
    rdfs:domain jpe:hypocenter ; rdfs:range xsd:dateTime .

jpe:magnitude a owl:DatatypeProperty ;
    rdfs:label "マグニチュード"@ja , "magnitude"@en ;
    rdfs:domain jpe:hypocenter ; rdfs:range xsd:decimal ;
    rdfs:subPropertyOf schema:value .

jpe:magnitudeType a owl:DatatypeProperty ;
    rdfs:label "マグニチュード種別"@ja , "magnitude type"@en ;
    rdfs:domain jpe:hypocenter ; rdfs:range xsd:string .

jpe:depth a owl:DatatypeProperty ;
    rdfs:label "震源の深さ"@ja , "hypocentral depth"@en ;
    rdfs:comment "基準面から震源までの深さをメートル単位で表す。提供機関が基準面より上の震源を負値で表す場合は原値を保持する。"@ja ;
    rdfs:domain jpe:hypocenter ; rdfs:range xsd:decimal ;
    rdfs:subPropertyOf schema:value .

jpe:shindo a owl:DatatypeProperty , sosa:ObservableProperty ;
    rdfs:label "震度"@ja , "JMA seismic intensity"@en ;
    rdfs:range rdfs:Literal .

jpe:calcShindo a owl:DatatypeProperty ;
    rdfs:label "計測震度"@ja , "instrumental seismic intensity"@en ;
    rdfs:domain jpe:observedWave ; rdfs:range xsd:decimal ;
    rdfs:subPropertyOf schema:value .

jpe:catalog a owl:DatatypeProperty ;
    rdfs:label "カタログ"@ja , "catalog"@en ;
    rdfs:comment "震源情報を提供した地震カタログまたは機関。"@ja ;
    rdfs:domain jpe:hypocenter ; rdfs:range xsd:string .

jpe:determinatedWay a owl:DatatypeProperty ;
    rdfs:label "震源決定方法"@ja , "hypocenter determination method"@en ;
    rdfs:comment "震源の決定方法または決定フラグ。震源を決定した機関はjpe:detarminatedByで表す。"@ja ;
    rdfs:domain jpe:hypocenter ; rdfs:range xsd:string .

jpe:hypocenterKinds a owl:DatatypeProperty ;
    rdfs:label "震源レコード種別"@ja , "hypocenter record type"@en ;
    rdfs:domain jpe:hypocenter ; rdfs:range xsd:string .

jpe:observedStationNum a owl:DatatypeProperty ;
    rdfs:label "観測点数"@ja , "number of observation stations"@en ;
    rdfs:comment "震度1以上を観測した観測点の数。"@ja ;
    rdfs:domain jpe:hypocenter ; rdfs:range xsd:nonNegativeInteger .

jpe:stationIdentifier a owl:DatatypeProperty ;
    rdfs:label "観測点番号"@ja , "station identifier"@en ;
    rdfs:comment "観測機関または観測網が定めた観測点の識別子。"@ja ;
    rdfs:domain jpe:observer ; rdfs:range xsd:string ;
    rdfs:subPropertyOf schema:identifier .

jpe:withTravelTimeTable a owl:DatatypeProperty ;
    rdfs:label "使用走時表"@ja , "travel-time table used"@en ;
    rdfs:domain jpe:hypocenter ; rdfs:range xsd:string .

jpe:recordIdentifier a owl:DatatypeProperty ;
    rdfs:label "強震記録ID"@ja ; rdfs:domain jpe:StrongMotionRecord ; rdfs:range xsd:string .
jpe:fileBaseName a owl:DatatypeProperty ;
    rdfs:label "波形ファイルベース名"@ja ; rdfs:domain jpe:StrongMotionRecord ; rdfs:range xsd:string .
jpe:sampleCount a owl:DatatypeProperty ;
    rdfs:label "サンプル数"@ja ; rdfs:domain jpe:StrongMotionRecord ; rdfs:range xsd:nonNegativeInteger .
jpe:samplingFrequency a owl:DatatypeProperty ;
    rdfs:label "サンプリング周波数 (Hz)"@ja ; rdfs:domain jpe:StrongMotionRecord ; rdfs:range xsd:decimal .
jpe:peakGroundAccelerationNS a owl:DatatypeProperty ; rdfs:label "南北成分最大加速度"@ja ; rdfs:domain jpe:StrongMotionRecord ; rdfs:range xsd:decimal .
jpe:peakGroundAccelerationEW a owl:DatatypeProperty ; rdfs:label "東西成分最大加速度"@ja ; rdfs:domain jpe:StrongMotionRecord ; rdfs:range xsd:decimal .
jpe:peakGroundAccelerationUD a owl:DatatypeProperty ; rdfs:label "上下成分最大加速度"@ja ; rdfs:domain jpe:StrongMotionRecord ; rdfs:range xsd:decimal .
jpe:peakGroundVelocityNS a owl:DatatypeProperty ; rdfs:label "南北成分最大速度"@ja ; rdfs:domain jpe:StrongMotionRecord ; rdfs:range xsd:decimal .
jpe:peakGroundVelocityEW a owl:DatatypeProperty ; rdfs:label "東西成分最大速度"@ja ; rdfs:domain jpe:StrongMotionRecord ; rdfs:range xsd:decimal .
jpe:peakGroundVelocityUD a owl:DatatypeProperty ; rdfs:label "上下成分最大速度"@ja ; rdfs:domain jpe:StrongMotionRecord ; rdfs:range xsd:decimal .
jpe:spectrumIntensity a owl:DatatypeProperty ; rdfs:label "SI値"@ja ; rdfs:domain jpe:StrongMotionRecord ; rdfs:range xsd:decimal .
jpe:instrumentalIntensity a owl:DatatypeProperty ; rdfs:label "計測震度"@ja ; rdfs:domain jpe:StrongMotionRecord ; rdfs:range xsd:decimal .
jpe:faultDistance a owl:DatatypeProperty ; rdfs:label "断層最短距離 (km)"@ja ; rdfs:domain jpe:StrongMotionRecord ; rdfs:range xsd:decimal .

# Object properties
jpe:hasHypocenter a owl:ObjectProperty ;
    rdfs:label "震源"@ja , "has hypocenter"@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( jpe:earthquake jpe:observedWave jpe:StrongMotionRecord ) ] ;
    rdfs:range jpe:hypocenter ; owl:inverseOf jpe:isHypocenterOf .

jpe:isHypocenterOf a owl:ObjectProperty ;
    rdfs:label "震源とする地震・観測"@ja , "is hypocenter of"@en ;
    rdfs:domain jpe:hypocenter .

jpe:detarminatedBy a owl:ObjectProperty ;
    rdfs:label "震源決定機関"@ja , "hypocenter determined by"@en ;
    rdfs:comment "震源位置・時刻を決定した機関をURIで示す。決定方法やフラグはjpe:determinatedWayで表す。"@ja ;
    rdfs:domain jpe:hypocenter ; rdfs:range prov:Agent ;
    rdfs:subPropertyOf prov:wasAttributedTo .

jpe:observedBy a owl:ObjectProperty ;
    rdfs:label "観測した観測点"@ja , "observed by"@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( jpe:observedWave jpe:StrongMotionRecord ) ] ; rdfs:range jpe:observer ;
    rdfs:subPropertyOf sosa:madeBySensor .

jpe:detarminatedWith a owl:ObjectProperty ;
    rdfs:label "震源決定に利用した波形"@ja ;
    rdfs:domain jpe:hypocenter ; rdfs:range jpe:observedWave .

jpe:estimatedWith a owl:ObjectProperty ;
    rdfs:label "震源推定に利用した波形"@ja ;
    rdfs:domain jpe:hypocenter ; rdfs:range jpe:observedWave .

jpe:mainShock a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "本震"@ja , "main shock"@en ;
    rdfs:domain jpe:earthquake ; rdfs:range jpe:hypocenter .

jpe:afterShock a owl:ObjectProperty ;
    rdfs:label "余震"@ja , "aftershock"@en ;
    rdfs:domain jpe:earthquake ; rdfs:range jpe:hypocenter .

jpe:foreShock a owl:ObjectProperty ;
    rdfs:label "前震"@ja , "foreshock"@en ;
    rdfs:domain jpe:earthquake ; rdfs:range jpe:hypocenter .

jpe:observationNetwork a rdf:Property ;
    rdfs:label "観測網"@ja , "observation network"@en ;
    rdfs:domain jpe:observer .

# Snapshot and provenance metadata. Individual resources should also use
# prov:wasDerivedFrom (or dcterms:source) when the provider exposes a stable URI.
jpe:snapshotOf a owl:ObjectProperty ;
    rdfs:label "スナップショット元データセット"@ja , "snapshot of"@en ;
    rdfs:domain jpe:DatasetSnapshot ; rdfs:range dcat:Dataset .

jpe:previousSnapshot a owl:ObjectProperty ;
    rdfs:label "直前のスナップショット"@ja , "previous snapshot"@en ;
    rdfs:domain jpe:DatasetSnapshot ; rdfs:range jpe:DatasetSnapshot ;
    rdfs:subPropertyOf prov:wasRevisionOf .

jpe:sourceChecksum a owl:DatatypeProperty ;
    rdfs:label "取得元チェックサム"@ja , "source checksum"@en ;
    rdfs:comment "取得した原本全体のSHA-256チェックサム。"@ja ;
    rdfs:domain jpe:DatasetSnapshot ; rdfs:range xsd:hexBinary .

# Deprecated misspellings retained for compatibility with earlier releases
jpe:detarminatedWay a owl:DatatypeProperty ;
    rdfs:label "震源決定方法（旧綴り）"@ja ;
    owl:deprecated true ; owl:equivalentProperty jpe:determinatedWay .

jpe:observedStaionNum a owl:DatatypeProperty ;
    rdfs:label "観測点数（旧綴り）"@ja ;
    owl:deprecated true ; owl:equivalentProperty jpe:observedStationNum .

jpe:seismicIntensity a owl:DatatypeProperty ;
    rdfs:label "計測震度（旧語彙）"@ja ;
    owl:deprecated true ; owl:equivalentProperty jpe:calcShindo .

jpe:preShock a owl:ObjectProperty ;
    rdfs:label "前震（旧語彙）"@ja ;
    owl:deprecated true ; owl:equivalentProperty jpe:foreShock .
